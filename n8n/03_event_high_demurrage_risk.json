{
  "name": "FreightIQ - 03 Event High Demurrage Risk Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "high-demurrage-event",
        "options": {}
      },
      "id": "node-webhook-inbound",
      "name": "Inbound High Demurrage Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "high-demurrage-event"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://node-gateway:3001/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-FreightIQ-Secret",
              "value": "freightiq-n8n-secure-token-2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"HIGH_DEMURRAGE_ALERT\",\n  \"action\": \"DISPATCH_PRIORITY_INTERVENTION\",\n  \"details\": {\n    \"port\": \"{{ $json.body.input.port }}\",\n    \"probability\": {{ $json.body.prediction.demurrage_probability }},\n    \"estimatedCost\": {{ $json.body.prediction.estimated_cost }},\n    \"recommendation\": \"{{ $json.body.prediction.recommendation }}\"\n  }\n}",
        "options": {}
      },
      "id": "node-post-alert-row",
      "name": "Create Alert & Broadcast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "node-notify-ops",
      "name": "Ops Dispatcher Notification (Placeholder)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [740, 300]
    }
  ],
  "connections": {
    "Inbound High Demurrage Webhook": {
      "main": [
        [
          {
            "node": "Create Alert & Broadcast",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Alert & Broadcast": {
      "main": [
        [
          {
            "node": "Ops Dispatcher Notification (Placeholder)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
