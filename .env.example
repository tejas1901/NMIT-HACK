# ==============================================================================
# FREIGHTIQ PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or configure in Vercel Project Settings.
# ==============================================================================

# --- Node Gateway Service (backend-node) ---
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
NODE_ENV=production
ALLOWED_ORIGINS=https://nmit-hack.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# --- Python ML / FastAPI Service (backend-ml) ---
ML_PORT=8000
ML_HOST=0.0.0.0
# On Vercel, BACKEND_ML_URL is automatically bound and injected by Vercel Services
BACKEND_ML_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8000

# --- Admin Role Elevation Security ---
ADMIN_PASSWORD_HASH="$2b$10$YourBcryptHashHere"
ADMIN_JWT_SECRET="freightiq-admin-elevation-jwt-secret-min32chars"

# --- Currency Configuration (Native INR) ---
USD_INR_RATE=86.40
VITE_USD_INR_RATE=86.40

# --- Supabase Cloud Configuration ---
SUPABASE_URL=https://iwcqkrzefoawlpugergc.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- QpiAI QCloud & Quantum Optimization ---
QPIAI_API_KEY=your-qpiai-api-key
QPIAI_USERNAME=your-qpiai-username
QPIAI_DEFAULT_DEVICE=QpiAI-QSV-Simulator
QPIAI_EXPERIMENT_NAME="Carrier QUBO Allocation"
QPIAI_BASE_URL=https://qcloud.qpiai.tech

# --- n8n Workflow Automation ---
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/freightguard-incident
N8N_WEBHOOK_SECRET=freightiq-n8n-secure-token-2026

# --- Generative AI & Copilot LLM Fallback ---
GEMINI_API_KEY=your-gemini-api-key
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
