# ==============================================================================
# FREIGHTIQ PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your secrets appropriately.
# NEVER commit the real .env file with secrets into version control.
# ==============================================================================

# --- Node Gateway Service ---
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Python ML / FastAPI Service ---
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0

# --- Admin Role Elevation Security ---
# Generated with bcrypt. Use 'npm run set:admin-password' to set
ADMIN_PASSWORD_HASH="$2b$10$YourBcryptHashHere"
ADMIN_JWT_SECRET="freightiq-admin-elevation-jwt-secret-min32chars"

# --- Currency Configuration (Native INR) ---
USD_INR_RATE=86.40
VITE_USD_INR_RATE=86.40

# --- Supabase Cloud Configuration ---
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- QpiAI QCloud & Quantum Optimization ---
QPIAI_API_KEY=your-qpiai-api-key
QPIAI_USERNAME=your-qpiai-username
QPIAI_DEFAULT_DEVICE=QpiAI-QSV-Simulator
QPIAI_EXPERIMENT_NAME="Default Experiment"
QPIAI_PREFER_REMOTE_CLOUD=true

# --- n8n Workflow Automation ---
N8N_INSTANCE_URL=https://your-instance.app.n8n.cloud
N8N_API_KEY=your-n8n-api-key
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/freightguard-incident
N8N_WEBHOOK_SECRET=freightiq-n8n-secure-token-2026

# --- Ollama / Local Copilot LLM ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Open-Meteo Weather Service ---
WEATHER_PROVIDER=open-meteo
WEATHER_REFRESH_INTERVAL_MINUTES=15
