# FreightIQ Environment Configuration

# --- User & Account Information ---
USER_EMAIL=user@example.com
GITHUB_USERNAME=your_username
GITHUB_PROFILE=https://github.com/your_username

# --- QpiAI QCloud Optimization Engine ---
QPIAI_USERNAME=your_qpiai_username
QPIAI_API_KEY=your_qpiai_api_key
QPIAI_DEFAULT_DEVICE=QpiAI-QSV-Simulator
QPIAI_EXPERIMENT_NAME=Default Experiment
QPIAI_PREFER_REMOTE_CLOUD=true

# --- n8n Workflow Automation ---
N8N_INSTANCE_URL=https://your-instance.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/freightguard-incident

# --- Supabase Database & Auth ---
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:password@db.your_project_ref.supabase.co:5432/postgres

# --- Cloud LLM & AI Copilot ---
ZHIPUAI_API_KEY=your_zhipuai_api_key
BIGMODEL_API_KEY=your_bigmodel_api_key

# --- Automatic Route Weather Intelligence (Open-Meteo) ---
WEATHER_PROVIDER=open-meteo
WEATHER_REFRESH_INTERVAL_MINUTES=30
WEATHER_SEVERE_WIND_GUST=65.0
WEATHER_SEVERE_PRECIP_MM=25.0
WEATHER_SEVERE_VISIBILITY_M=500.0
WEATHER_HIGH_WIND_GUST=45.0
WEATHER_HIGH_PRECIP_MM=10.0
WEATHER_HIGH_VISIBILITY_M=1000.0
WEATHER_MOD_WIND_GUST=30.0
WEATHER_MOD_PRECIP_MM=3.0
WEATHER_MOD_VISIBILITY_M=3000.0
